{
  "name": "whatsapp-cli",
  "version": "0.1.0",
  "description": "Send WhatsApp messages, groups and batches from the terminal using Baileys",
  "type": "module",
  "bin": {
    "whatsapp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.pt-BR.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "whatsapp",
    "cli",
    "baileys",
    "messaging",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "baileys": "^6.7.24",
    "commander": "^15.0.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
